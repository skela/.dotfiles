/* System tray menu styling to match bar theme */

QMenu {
    background-color: #0d1e30;
    color: #d0e4f8;
    border: 1px solid #00a8f8;
    border-radius: 5px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #1a3a52;
    color: #00a8f8;
}

QMenu::item:disabled {
    color: #7a9ec0;
}

QMenu::separator {
    height: 1px;
    background-color: #2d5070;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::right-arrow {
    width: 12px;
    height: 12px;
}
