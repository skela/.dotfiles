{
	"output": ["DP-4"],
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-center": ["hyprland/window"],
	"modules-right": [
		"custom/recording",
		"custom/idle-inhibit",
		"custom/clipboard",
		"network",
		"pulseaudio",
		"cpu",
		"memory",
		"temperature",
		"hyprland/language",
		"custom/pacman",
		"tray",
		"clock",
		"custom/notifications"
	],
	"include": ["~/.dotfiles/config/hypr/waybar/common.jsonc"]
}
